{
  "permissions": {
    "allow": [
      "Read(**)",
      "Exec(git status)",
      "Exec(git diff)",
      "Exec(git log)",
      "Exec(git show)",
      "Exec(ls)",
      "Exec(cat)",
      "Exec(grep)",
      "Exec(find)",
      "Exec(bun run typecheck)",
      "Exec(bun run check)",
      "Exec(bun test)",
      "Exec(bun run build)"
    ],
    "deny": [
      "Exec(rm)",
      "Exec(rmdir)",
      "Exec(del)",
      "Exec(format)",
      "Exec(sudo)",
      "Exec(git push)",
      "Exec(git reset --hard)",
      "Exec(git clean -f)",
      "Write(.env*)"
    ],
    "ask": []
  },
  "read_config_from": {
    "agents_standard": true
  }
}
