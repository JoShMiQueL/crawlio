{
  "name": "crawlio",
  "version": "0.1.0",
  "description": "Simple, typed web scraping for static HTML",
  "keywords": [
    "scraper",
    "scraping",
    "html-parser",
    "css-selectors",
    "web-scraping",
    "cheerio",
    "parsing",
    "structured-data",
    "extraction",
    "typescript"
  ],
  "homepage": "https://github.com/JoShMiQueL/crawlio#readme",
  "bugs": {
    "url": "https://github.com/JoShMiQueL/crawlio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/crawlio.git"
  },
  "author": "JoShMiQueL",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "crawlio": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/render/playwright.d.ts",
      "default": "./dist/render/playwright.js"
    },
    "./puppeteer": {
      "types": "./dist/render/puppeteer.d.ts",
      "default": "./dist/render/puppeteer.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepack": "pnpm check && pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.0.0",
    "playwright-core": "^1.64.1",
    "publint": "^0.3.25",
    "puppeteer-core": "25.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "p-limit": "^7.3.3",
    "p-retry": "^8.0.1",
    "robots-parser": "^3.0.1",
    "undici": "8.12.2"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40",
    "puppeteer-core": ">=24.21"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  }
}
