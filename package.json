{
  "name": "crawlio",
  "version": "0.1.0",
  "description": "Simple, typed web scraping for static HTML",
  "keywords": [
    "scraper",
    "scraping",
    "html-parser",
    "css-selectors",
    "web-scraping",
    "cheerio",
    "parsing",
    "structured-data",
    "extraction",
    "typescript"
  ],
  "homepage": "https://github.com/JoShMiQueL/crawlio#readme",
  "bugs": {
    "url": "https://github.com/JoShMiQueL/crawlio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/crawlio.git"
  },
  "author": "JoShMiQueL",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "crawlio": "./dist/cli.js",
    "crawlio-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/render/playwright.d.ts",
      "default": "./dist/render/playwright.js"
    },
    "./puppeteer": {
      "types": "./dist/render/puppeteer.d.ts",
      "default": "./dist/render/puppeteer.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "default": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bin": "bun scripts/build-bin.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.scripts.json",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:pack": "publint && attw --pack . --profile esm-only",
    "prepack": "bun run check && bun run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "bun-types": "1.4.3",
    "playwright-core": "1.64.1",
    "publint": "0.3.25",
    "puppeteer-core": "25.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "robots-parser": "3.0.1",
    "undici": "8.12.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.32",
    "playwright-core": ">=1.40",
    "puppeteer-core": ">=24.21",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
